# start-system automatically creates .env with random local secrets.
# Never commit .env. Change WEB_PORT if 9528 is already occupied.
WEB_PORT=9528
MYSQL_ROOT_PASSWORD=replace-with-a-random-secret
DB_PASSWORD=replace-with-another-random-secret
CAMPUS_JWT_SECRET=replace-with-at-least-32-random-characters
CAMPUS_IDENTITY_TEST_MODE=true
CAMPUS_ALLOWED_ORIGINS=http://localhost:9528,http://127.0.0.1:9528,http://10.*:9528,http://172.*:9528,http://192.168.*:9528
